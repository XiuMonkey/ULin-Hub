// ULinCore Intent 编辑模板（JSON5）
//
// 运行时 UlinCoreIntentStore 只接受严格 JSON 数组：
//   - 不能用注释、尾逗号、单引号
//   - 本文件是给人看的模板，正式落盘前必须转成严格 JSON
//   - 路径：data/ulincore/intents.json
//
// 当前模型：
//   Intent = name + description + parameters + prompt + skill + steps + executor
//
// 执行优先级：
//   executor 非空 -> Native
//   steps 非空    -> Chain
//   prompt 非空   -> Prompt
//
// 调用期标签（不要写进本文件）：
//   asPrompt / asSkill / withSkill / save / defineOnly / generateOnly /
//   agentEngaged / skillRequired
//
// 规则：
//   - name 是唯一键；内置 Intent 与用户 Intent 同名时以内置为准。
//   - parameters 里没有 default 的参数为必填。
//   - prompt 支持 [name] 和 {{name}} 占位符。
//   - skill 是方法（how）；不能单独执行。
//   - steps 的 intent 必须是已存在的 Intent 名（内置或用户）。
//   - steps[].arguments 可用 { "$param": "参数名" } 引用本次参数。
//   - executor 必须是完整执行器 ID，例如 builtin.read_file；
//     当前不自动去掉 builtin. 前缀。
//   - steps 只保存调用名和参数，不保存 id / result / 执行日志。
//
// 三种语义类型由调用现场决定，不写在这里：
//   Intent 元数据 -> 定义型
//   无 Intent + 无同名 Intent -> 生成型
//   无 Intent + 有同名 Intent -> 执行型
//
// 本文件中的对象只描述“已定义 Intent”。

[
  // ---------------------------------------------------------------------------
  // 1. Prompt Intent
  // ---------------------------------------------------------------------------
  {
    name: 'example.prompt',
    description: '把主题扩写成一段说明',
    parameters: [
      { name: 'topic', type: 'string' },                    // 必填
      { name: 'style', type: 'string', default: '简洁' },   // 可选
      { name: 'max_items', type: 'number', default: 5 },
      { name: 'include_examples', type: 'boolean', default: true },
    ],
    prompt: '请用 [style] 风格介绍 {{topic}}。\n最多列出 [max_items] 个要点。\ninclude_examples = {{include_examples}}。',
    skill: '',
    steps: [],
    executor: '',
  },

  // ---------------------------------------------------------------------------
  // 2. Chain Intent
  // ---------------------------------------------------------------------------
  {
    name: 'example.chain',
    description: '先读文件，再搜索内容',
    parameters: [
      { name: 'path', type: 'string' },
      { name: 'keyword', type: 'string' },
      { name: 'maxResults', type: 'number', default: 20 },
    ],
    prompt: '',
    skill: '',
    steps: [
      {
        intent: 'read_file',
        arguments: {
          path: { '$param': 'path' },
        },
      },
      {
        intent: 'search_text',
        arguments: {
          path: { '$param': 'path' },
          query: { '$param': 'keyword' },
          maxResults: { '$param': 'maxResults' },
        },
      },
    ],
    executor: '',
  },

  // ---------------------------------------------------------------------------
  // 3. Prompt + Chain
  // ---------------------------------------------------------------------------
  {
    name: 'example.prompt_or_chain',
    description: '既能按 Prompt 执行，也能按 Chain 执行',
    parameters: [
      { name: 'path', type: 'string' },
      { name: 'question', type: 'string', default: '总结这个文件' },
    ],
    prompt: '请阅读 {{path}}，然后回答：[question]',
    skill: '先读取文件，再回答用户问题。',
    steps: [
      {
        intent: 'read_file',
        arguments: {
          path: { '$param': 'path' },
        },
      },
    ],
    executor: '',
  },

  // ---------------------------------------------------------------------------
  // 4. Native Intent
  // ---------------------------------------------------------------------------
  {
    name: 'example.native',
    description: '客户端原生执行器',
    parameters: [
      { name: 'path', type: 'string' },
      { name: 'maxBytes', type: 'number', default: 65536 },
    ],
    prompt: '',
    skill: '',
    steps: [],
    // 必须是完整执行器 ID；内置执行器统一使用 builtin.*
    executor: 'builtin.read_file',
  },
]
