// ULinCore Intent 编辑模板（JSON5）
//
// 说明：
// - 运行时 UlinCoreIntentStore 读的是严格 JSON 数组；本文件是给人和编辑器看的模板，
//   带注释、尾逗号和单引号，正式落盘前要转成严格 JSON。
// - 顶层必须是 Intent 数组。
// - name 是唯一键；同名 Intent 会覆盖。
// - prompt 非空 = 可走 Prompt 模式；steps 非空 = 可走 Chain 模式。
// - prompt 非空且 steps 为空时默认走 Prompt；steps 非空时默认走 Chain。
// - parameters 里没有 default 的参数 = 必填。
// - prompt 支持 [name] 和 {{name}} 两种占位符。
// - skill 非空 = 泛化方法（how）；不能单独执行，AsSkill 时必须同时有 prompt。
// - hasSkill 是调用期元数据：要求 Agent 保存方案里必须生成 skill。
// - AsSkill 是执行期元数据：使用 prompt + skill，不执行 steps/executor。
// - executor 非空 = 原生客户端执行器；
// - steps[].arguments 里可用 { "$param": "参数名" } 引用本次参数。
// - steps 是声明式 Recipe 步骤，形如 { intent, arguments }；
//   它对应模型 tool call 的 name + arguments，但不保存调用 id / result，
//   也不是会话执行日志。完整 ToolCall 记录在 Message.toolCalls 里。
//
// 注意：asPrompt / save / agentEngaged / createPromptIntent 是“调用时”的
// UlinCoreInvocation 控制位，不是 Intent 持久化字段，不要写进本数组。

[
  // ---------------------------------------------------------------------------
  // 示例 1：Prompt-only Intent
  // ---------------------------------------------------------------------------
  {
    name: 'example.prompt',
    description: '示例：把主题扩写成一段说明',
    parameters: [
      { name: 'topic', type: 'string' },                    // 必填
      { name: 'style', type: 'string', default: '简洁' },   // 可选，默认值
      { name: 'max_items', type: 'number', default: 5 },
      { name: 'include_examples', type: 'boolean', default: true },
    ],
    prompt: '请用 [style] 风格介绍 {{topic}}。\n最多列出 [max_items] 个要点。\ninclude_examples = {{include_examples}}。',
    steps: [],
  },

  // ---------------------------------------------------------------------------
  // 示例 2：Prompt + Chain（默认走 Chain）
  // ---------------------------------------------------------------------------
  {
    name: 'example.chain',
    description: '示例：先读文件，再搜索内容',
    parameters: [
      { name: 'path', type: 'string' },
      { name: 'keyword', type: 'string' },
      { name: 'limit', type: 'number', default: 20 },
    ],
    // prompt 可留空；有 steps 时默认走 Chain。
    // 若希望 Chain 失败时回退到 Prompt，可在这里放一段兜底模板。
    prompt: '',
    skill: '',
    steps: [
      {
        intent: 'read_file',
        arguments: {
          path: { '$param': 'path' },
        },
      },
      {
        intent: 'search_text',
        arguments: {
          path: { '$param': 'path' },
          query: { '$param': 'keyword' },
          limit: { '$param': 'limit' },
        },
      },
    ],
  },

  // ---------------------------------------------------------------------------
  // 示例 3：Prompt + Chain 都提供（默认 Chain，AsPrompt 可强制走 Prompt）
  // ---------------------------------------------------------------------------
  {
    name: 'example.prompt_or_chain',
    description: '示例：既能按 Prompt 执行，也能按工具链执行',
    parameters: [
      { name: 'path', type: 'string' },
      { name: 'question', type: 'string', default: '总结这个文件' },
    ],
    prompt: '请阅读 {{path}}，然后回答：[question]',
    skill: '先读取文件，再回答用户问题。',
    steps: [
      {
        intent: 'read_file',
        arguments: {
          path: { '$param': 'path' },
        },
      },
    ],
  },

  // ---------------------------------------------------------------------------
  // 示例 4：Native Intent（执行器写死在客户端）
  // ---------------------------------------------------------------------------
  {
    name: 'example.native',
    description: '示例：客户端原生执行器',
    parameters: [
      { name: 'path', type: 'string' },
    ],
    prompt: '',
    skill: '',
    steps: [],
    executor: 'builtin.read_file',
  },
]
