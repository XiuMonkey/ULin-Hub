  <!-- QtTranslation 的 BuildAction **必须保持 false**（即不参与构建）。
       合法取值只有 lupdate / lrelease / lupdate_lrelease / false
       （见 QtMsBuild\translation\qttranslation.xml），而 qttranslation.targets 的判据是
       "BuildAction 字面包含 lupdate / lrelease"。所以写成 true 是无效值，它**什么都不触发**
       —— 之前那句"设成 true 就会跑 lupdate/lrelease"是误解。
       ⚠️ 绝不能改成 lupdate / lupdate_lrelease：本项目是 ID-based（qtTrId），
       语言包由 tools\release-translations.ps1 生成，.ts 里只维护译文（不写 <source>）；
       跑一次 lupdate 会把译文回标成 type="unfinished"，lrelease 随即把它们丢弃
       —— 结果是语言包整片失效、界面满屏 key。
       下面的 <QtTranslation> 条目只用于在 IDE 里能打开这份 .ts，不产生任何构建动作。 -->
  <ItemDefinitionGroup>
    <QtTranslation>
      <BuildAction>false</BuildAction>
    </QtTranslation>
  </ItemDefinitionGroup>
  <!-- .qm 的发布不走 PostBuildEvent：Qt VS Tools 的 QtTranslation 目标不负责拷贝产物，
       而客户端从 exe 同目录的 translations/ 加载（见 TranslationManager.cpp）。
       发布用 tools\release-translations.ps1（跑 lrelease 到 x64\<Config>\translations），
       理由与用法写在该脚本头部。 -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Condition="Exists('$(QtMsBuild)\qt.targets')">
    <Import Project="$(QtMsBuild)\qt.targets" />
  </ImportGroup>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
